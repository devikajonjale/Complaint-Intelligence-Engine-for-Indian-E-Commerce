# Copy to .streamlit/secrets.toml for local use, or paste these into the Streamlit Community Cloud
# app settings under Secrets. secrets.toml itself is gitignored.

GROQ_API_KEY = "your_free_groq_key"

# Hosted deployment settings:
#   disable the pipeline refresh button (it would scrape and retrain inside the container)
CIE_DISABLE_PIPELINE_REFRESH = "1"
#   hide the cross-encoder reranker (its weights are a 464 MB download)
RAG_ENABLE_RERANK = "0"
