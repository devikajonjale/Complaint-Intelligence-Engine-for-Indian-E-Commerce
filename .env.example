# Copy to .env and fill in. Never commit .env.
# Groq free tier key (no card needed): https://console.groq.com
# Models are pinned in rag/config.py (Groq only, free tier).
GROQ_API_KEY=

# Default retrieval strategy: hybrid (dense + BM25), rerank (hybrid + local cross-encoder) or dense.
# The Streamlit page can override this per query.
RAG_RETRIEVER=hybrid
